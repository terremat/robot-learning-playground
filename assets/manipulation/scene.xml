
<mujoco model="manipulation_scene">
    <include file="../franka_emika_panda/panda.xml"/>
    <compiler meshdir="../franka_emika_panda/assets"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <visual>
        <global azimuth="135" elevation="-25"/>
    </visual>

    <worldbody>
        <light pos="0 0 2" dir="0 0 -1"/>

        <!-- Fixed table -->
        <body name="table" pos="0.5 0 0">
            <geom
                name="table_collision"
                type="box"
                size="0.4 0.4 0.025"
                mass="32"
                friction="1 0.005 0.0001"
                rgba="0.7 0.7 0.7 1"
            />
        </body>

        <!-- Free cube -->
        <body name="cube" pos="0.5 0 0.032">
            <freejoint name="cube_freejoint"/>

            <geom
                name="cube_geom"
                type="box"
                size="0.0215 0.0215 0.022"
                mass="0.08"
                friction="1 0.005 0.0001"
                rgba="0.9 0.1 0.1 1"
            />
        </body>
    </worldbody>
</mujoco>
